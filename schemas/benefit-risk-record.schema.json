{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benefit-risk-record.schema.json",
  "title": "Benefit-Risk Record",
  "description": "Bounded benefit and residual-risk evidence for a decision.",
  "type": "object",
  "properties": {
    "subject_id": { "type": "string" },
    "claimed_benefit": { "type": "string" },
    "benefit_evidence": { "type": "string" },
    "beneficiaries": { "type": "string" },
    "known_harms": { "type": "string" },
    "plausible_harms": { "type": "string" },
    "severity": { "type": "string" },
    "reversibility": { "type": "string" },
    "mitigations": { "type": "string" },
    "residual_risk": { "type": "string" },
    "authority_effect": { "type": "string", "const": "NONE" }
  },
  "required": ["subject_id", "authority_effect"],
  "additionalProperties": false
}
