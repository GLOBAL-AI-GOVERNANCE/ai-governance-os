{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-assurance-record.schema.json",
  "title": "Model Assurance Record",
  "description": "Reference record for one model configuration. The governed unit is data, preprocessing, features, model, thresholds, environment, humans, and operating conditions. It does not approve deployment.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "model_family": {
      "type": "string",
      "minLength": 1
    },
    "training_run": {
      "type": "string",
      "minLength": 1
    },
    "dataset_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preprocessing": {
      "type": "string",
      "minLength": 1
    },
    "algorithm_configuration": {
      "type": "string",
      "minLength": 1
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "intended_use": {
      "type": "string",
      "minLength": 1
    },
    "prohibited_use": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluation_ref": {
      "type": "string",
      "minLength": 1
    },
    "calibration_thresholds": {
      "type": "string",
      "minLength": 1
    },
    "known_failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "monitoring": {
      "type": "string",
      "minLength": 1
    },
    "drift_policy": {
      "type": "string",
      "minLength": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reference_only": {
      "type": "boolean",
      "const": true
    },
    "authority_effect": {
      "type": "string",
      "const": "NONE",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "subject_id",
    "configuration_digest",
    "task",
    "model_family",
    "training_run",
    "dataset_refs",
    "features",
    "preprocessing",
    "algorithm_configuration",
    "artifact_digest",
    "environment",
    "intended_use",
    "prohibited_use",
    "evaluation_ref",
    "calibration_thresholds",
    "known_failure_modes",
    "dependencies",
    "monitoring",
    "drift_policy",
    "rollback",
    "owner",
    "reference_only",
    "authority_effect"
  ]
}
