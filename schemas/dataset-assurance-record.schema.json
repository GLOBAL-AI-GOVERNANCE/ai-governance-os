{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset-assurance-record.schema.json",
  "title": "Dataset Assurance Record",
  "description": "Reference record for a dataset used in qualification. It does not establish that the dataset is representative or that a model is fit for use.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "minLength": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "source_provenance": {
      "type": "string",
      "minLength": 1
    },
    "window_population": {
      "type": "string",
      "minLength": 1
    },
    "labels": {
      "type": "string",
      "minLength": 1
    },
    "schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "quality": {
      "type": "string",
      "minLength": 1
    },
    "missingness": {
      "type": "string",
      "minLength": 1
    },
    "sampling_bias_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "splits_leakage": {
      "type": "string",
      "minLength": 1
    },
    "version_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "freshness": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reference_only": {
      "type": "boolean",
      "const": true
    },
    "authority_effect": {
      "type": "string",
      "const": "NONE",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "subject_id",
    "configuration_digest",
    "purpose",
    "source_provenance",
    "window_population",
    "labels",
    "schema_ref",
    "quality",
    "missingness",
    "sampling_bias_limitations",
    "splits_leakage",
    "version_hash",
    "freshness",
    "owner",
    "reference_only",
    "authority_effect"
  ]
}
